<Project Sdk="Microsoft.NET.Sdk">

  <!--
    経済シミュレーションの中核。ADR-0001 によりエンジン非依存を厳守する。

    この禁止が守っているのは「エンジン非依存」であって、依存数ゼロそれ自体ではない。
    したがって禁止するのは Godot およびプレゼンテーション層への依存であり、
    Microsoft 公式の小規模パッケージは決定論の検証などに必要なら例外とする。
    ただし追加時は、なぜ標準ライブラリで足りないかを必ずここにコメントで書くこと。

    現在の実行時依存: System.IO.Hashing(XxHash64)。状態ハッシュに使う(TDD01 §3.8)。
      標準の System.HashCode / string.GetHashCode はプロセスごとにシードが
      ランダム化され、別プロセス間で値が一致しないため代用できない。
      版は 8.0.0 に固定する。TFM(net8.0)と global.json の SDK 8.0.424 に帯を揃える。
  -->
  <PropertyGroup>
    <RootNamespace>Visionary.Sim</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Hashing" Version="8.0.0" />
  </ItemGroup>

  <!--
    ADR-0002 の決定論規約を、CLAUDE.md の散文ではなくビルドエラーとして強制する。
    禁止対象は BannedSymbols.txt を参照。違反は RS0030 として報告され、
    Directory.Build.props の TreatWarningsAsErrors により build を失敗させる。

    PrivateAssets=all なので、この禁止は Visionary.Sim にのみ効く。Runner 側の
    統計計算(TDD01 §4.2 の CV・Gini・HHI)は浮動小数点でよく、シムの再現性に影響しない。
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="3.3.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>

</Project>
